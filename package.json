{
    "name": "goblin-nightclub",
    "version": "0.1.0",
    "description": "A 2D WebAssembly + WebGPU game",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "author": "Andrew Stein <steinlink@gmail.com>",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:dev": "node scripts/build.mjs --dev",
        "tiles": "node scripts/tiles.mjs",
        "dev": "node scripts/dev.mjs",
        "serve": "node scripts/dev.mjs --release",
        "deploy": "node scripts/deploy.mjs",
        "test": "cargo test --workspace",
        "check": "cargo clippy --workspace --target wasm32-unknown-unknown -- -D warnings",
        "fmt": "cargo fmt",
        "pack": "cargo run --release -q -p goblin-nightclub-generate --bin pack --",
        "clean": "rm -rf dist target"
    }
}
