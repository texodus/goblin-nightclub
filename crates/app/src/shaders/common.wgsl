// What both shaders share: noise, and how light falls off. Before this
// come the constants they need from Rust (`TILE`, `NO_PAGE`,
// `TABLE_HEAD`), written by `crate::shaders` from Rust's own, so they
// can't drift apart.

// Width (world units) of the band at the edge of the viewer's sight, or of
// a light, where what's seen fades from view.
const FADE: f32 = 12.0;

// A light (see `goblin_nightclub_core::vision::Lit`), or the viewer's own:
// how bright at its heart and at its rim, and how much of its color it
// casts (the rest white).
const LIGHT_HEART: f32 = 1.1;
const LIGHT_RIM: f32 = 0.4;
const LIGHT_WARMTH: f32 = 0.6;

fn hash(p: vec2<f32>) -> f32 {
    let q = fract(p * vec2(0.1031, 0.1030));
    let r = q + dot(q, q.yx + 33.33);
    return fract((r.x + r.y) * r.x);
}

// Smooth value noise in [0, 1], a lattice point every unit.
fn value_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let a = hash(i);
    let b = hash(i + vec2(1.0, 0.0));
    let c = hash(i + vec2(0.0, 1.0));
    let d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
